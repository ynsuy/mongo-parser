#!/usr/bin/env bash
# Runs the mongo-log-parser release this plugin version was published with, downloading it from
# the GitHub release once. MONGO_LOG_PARSER_BIN points at another build instead, e.g. a local one.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ -n "${MONGO_LOG_PARSER_BIN:-}" ]]; then
  exec "$MONGO_LOG_PARSER_BIN" "$@"
fi

version="$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" | head -1)"
# Not the host's plugin data directory: Codex gives that to hooks but not to MCP servers, and both
# have to find the same binary.
data="${XDG_CACHE_HOME:-$HOME/.cache}/mongo-diagnoser"
binary="$data/mongo-log-parser-v$version"

if [[ ! -x "$binary" ]]; then
  # The hook runs before every file and shell tool call; it must not stall on a download, and with
  # no parser yet no bundle has been read through it either.
  [[ "${1:-}" == hook ]] && exit 0

  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m)"
  case "$arch" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; esac
  asset="mongo-log-parser_${os}_${arch}"
  url="https://github.com/ynsuy/pidba/releases/download/mongo-log-parser/v$version"

  mkdir -p "$data"
  tmp="$(mktemp "$data/.download.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  echo "mongo-diagnoser: downloading mongo-log-parser v$version ($os/$arch)" >&2
  curl -fsSL "$url/$asset" -o "$tmp"
  expected="$(curl -fsSL "$url/checksums.txt" | awk -v a="$asset" '$2 == a { print $1 }')"
  if command -v sha256sum >/dev/null; then
    actual="$(sha256sum "$tmp" | awk '{ print $1 }')"
  else
    actual="$(shasum -a 256 "$tmp" | awk '{ print $1 }')"
  fi
  if [[ -z "$expected" || "$expected" != "$actual" ]]; then
    echo "mongo-diagnoser: checksum mismatch for $asset; not installing it" >&2
    exit 1
  fi
  chmod +x "$tmp"
  mv "$tmp" "$binary"
fi

exec "$binary" "$@"
